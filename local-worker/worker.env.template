# Public URL of your DUBVI web control plane, without a trailing slash.
DUBVI_API_BASE=https://douyin-vn-cajtmpaq.manus.space

# Generated only once from the DUBVI interface. Treat it as a password for this worker.
DUBVI_WORKER_TOKEN=dubvi_replace_with_pairing_token

# Absolute path containing the original videos. The worker never uploads files from this directory.
DUBVI_MEDIA_DIR=/absolute/path/to/douyin-videos

# Optional output directory. Defaults to <DUBVI_MEDIA_DIR>/dubvi-output.
# DUBVI_OUTPUT_DIR=/absolute/path/to/douyin-videos/dubvi-output

# Optional directories. They persist downloaded Whisper/Argos models and worker/job logs locally.
# DUBVI_MODEL_DIR=/absolute/path/to/douyin-videos/dubvi-model-cache
# DUBVI_LOG_DIR=/absolute/path/to/douyin-videos/dubvi-logs

# Use cpu for most machines. CUDA requires compatible local NVIDIA drivers.
DUBVI_DEVICE=cpu
DUBVI_WHISPER_MODEL=small
DUBVI_POLL_SECONDS=10

# Marian is the local fallback if Argos lacks Chinese → Vietnamese. First download is roughly 300 MB.
DUBVI_MT_MODEL=Helsinki-NLP/opus-mt-zh-vi
